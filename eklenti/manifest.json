{
  "manifest_version": 3,
  "name": "Eczane Stok - Depo Köprüsü",
  "version": "1.0.0",
  "description": "Açık depo sekmesinden (Sancak) fiyat ve MF bilgisini okuyup Eczane Stok toplayıcısına verir. Sadece okur: sepet/sipariş yok.",
  "permissions": ["alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://eticaret.sancakecza.com.tr/*",
    "http://127.0.0.1:47811/*"
  ],
  "background": { "service_worker": "arka.js" },
  "content_scripts": [{
    "matches": ["https://eticaret.sancakecza.com.tr/*"],
    "js": ["sancak.js"],
    "run_at": "document_idle"
  }]
}
